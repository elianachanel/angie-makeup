# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) — NO uses la Secret key aquí
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# WhatsApp — número con código de país, sin + ni espacios (ej. 18095551234)
NEXT_PUBLIC_WHATSAPP_NUMBER=18094924596

# Solo servidor (Vercel) — Supabase → Settings → API → service_role (secreto)
# Necesario para borrar reservas antiguas cada mes. NUNCA uses NEXT_PUBLIC_ aquí.
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Vercel lo genera al desplegar crons; protege las rutas /api/cron/*
# CRON_SECRET=
